{
  "name": "ghostbuild",
  "description": "AI project builder for Cloudflare with TanStack Start as the default web framework",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://ghostbuild.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdousbhai/ghost-build.git"
  },
  "bugs": {
    "url": "https://github.com/ferdousbhai/ghost-build/issues"
  },
  "type": "module",
  "version": "0.0.7",
  "scripts": {
    "workers-builds:build": "pnpm install --frozen-lockfile && node scripts/check-workers-builds-environment.mjs && pnpm run validate && node scripts/deploy-production.mjs --check-workers-builds",
    "workers-builds:deploy": "node scripts/deploy-production.mjs --check-workers-builds && pnpm run provision:production:check && pnpm run verify:production-config && pnpm run verify:workers-builds-config && pnpm run d1:bookmark:production && pnpm run d1:migrations:apply:production && node scripts/deploy-production.mjs",
    "workers-builds:preview": "node scripts/upload-workers-builds-preview.mjs",
    "build": "pnpm run generate:user-workspace-runtime && vite build",
    "build:analyze": "pnpm run build && pnpm run bundle:report",
    "bundle:check": "node scripts/report-client-bundle.mjs --max-raw-kb=500 --max-total-gzip-kb=1300 --max-total-brotli-kb=1100 --isolated-asset-prefix=opfs-worker- --max-isolated-raw-kb=1750 --max-isolated-gzip-kb=725 --max-isolated-brotli-kb=600 --limit=15",
    "bundle:report": "node scripts/report-client-bundle.mjs",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "sbom:production": "node scripts/verify-production-licenses.mjs --spdx",
    "licenses:generate": "node scripts/verify-production-licenses.mjs --write-notices",
    "build:system-prompts": "tsc --ignoreConfig buildSystemPrompts.ts --outDir dist --module esnext --target es2022 --moduleResolution bundler --types node --allowImportingTsExtensions false",
    "d1:bookmark:production": "node scripts/record-d1-time-travel-bookmark.mjs",
    "cf-typegen": "wrangler types",
    "d1:migrations:apply:production": "wrangler d1 migrations apply ghostbuild --remote",
    "generate-routes": "tsr generate",
    "generate:user-workspace-runtime": "node scripts/build-user-workspace-runtime.mjs",
    "rebuild-template": "node make-bootstrap-snapshot.js",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:critical": "playwright test e2e/launch-critical-journey.spec.ts --project=launch-critical-chromium --reporter=line",
    "test:watch": "vitest",
    "lint:code": "eslint --cache --cache-location ./node_modules/.cache/eslint app ghostbuild-agent scripts make-bootstrap-snapshot.js",
    "lint": "pnpm run lint:code && prettier -c .",
    "lint:fix-code": "pnpm run lint:code -- --fix",
    "lint:fix": "pnpm run lint:fix-code && prettier --write .",
    "typecheck": "pnpm run generate-routes && pnpm run cf-typegen && pnpm run generate:user-workspace-runtime && tsc",
    "clean": "node scripts/clean.js",
    "provision:production": "node scripts/provision-cloudflare-production.mjs",
    "provision:production:check": "node scripts/provision-cloudflare-production.mjs --check",
    "verify:stack": "node scripts/verify-stack-alignment.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:workers-builds-config": "node scripts/verify-workers-builds-config.mjs",
    "verify:licenses": "node scripts/verify-production-licenses.mjs",
    "verify:built-ssr": "node scripts/verify-built-ssr.mjs",
    "verify:built-browser": "playwright test e2e/built-browser.spec.ts",
    "verify:static-assets": "node scripts/verify-static-assets.mjs",
    "validate:root": "pnpm run verify:stack && pnpm run verify:production-config && pnpm run verify:workers-builds-config && pnpm run verify:licenses && pnpm run audit:dependencies && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:workerd && pnpm run knip && pnpm run build && pnpm run verify:built-ssr && pnpm run verify:static-assets && pnpm run bundle:check",
    "validate:agent": "pnpm --dir ghostbuild-agent run typecheck && pnpm --dir ghostbuild-agent run test",
    "validate:template": "node scripts/verify-template.mjs",
    "validate:public-beta": "pnpm run validate && pnpm run verify:built-browser",
    "validate": "pnpm run validate:root && pnpm run validate:agent && pnpm run validate:template",
    "knip": "knip --treat-config-hints-as-errors"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.4",
    "@ai-sdk/react": "4.0.51",
    "@cloudflare/ai-chat": "^0.10.1",
    "@cloudflare/computer": "0.1.1",
    "@cloudflare/sandbox": "0.12.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-wast": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@heroicons/react": "^2.2.0",
    "@journeyapps/wa-sqlite": "1.7.2",
    "@noble/hashes": "2.2.0",
    "@nanostores/react": "^0.8.4",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@summonghost/compaction": "0.1.3",
    "@summonghost/title-generation": "0.1.1",
    "@tanstack/browser-db-sqlite-persistence": "0.2.9",
    "@tanstack/db": "^0.6.17",
    "@tanstack/query-db-collection": "^1.2.1",
    "@tanstack/react-db": "^0.1.95",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "@uidotdev/usehooks": "^2.4.1",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "agents": "^0.20.1",
    "ai": "7.0.48",
    "date-fns": "^3.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "ghostbuild-agent": "workspace:*",
    "jszip": "^3.10.1",
    "nanostores": "^0.11.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "unist-util-visit": "^5.1.0",
    "workers-ai-provider": "4.0.0",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@blitz/eslint-plugin": "0.1.5",
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@playwright/test": "1.62.1",
    "@tanstack/router-cli": "^1.167.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "jsdom": "^26.1.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^5.88.1",
    "postcss": "^8.5.25",
    "postcss-mixins": "^11.0.3",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.9.6",
    "tailwind-scrollbar": "3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.2.0",
    "vite-plugin-optimize-css-modules": "^1.4.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "packageManager": "pnpm@11.14.0"
}
