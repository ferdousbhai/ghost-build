{
  "name": "ghostbuild",
  "description": "AI project builder for Cloudflare with TanStack Start as the default web framework",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://ghostbuild.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdousbhai/ghostbuild.git"
  },
  "bugs": {
    "url": "https://github.com/ferdousbhai/ghostbuild/issues"
  },
  "type": "module",
  "version": "0.0.7",
  "scripts": {
    "deploy": "pnpm run deploy:production",
    "deploy:production": "pnpm run validate && pnpm run provision:production && pnpm run verify:production-config && pnpm run d1:migrations:apply:production && node scripts/deploy-production.mjs",
    "build": "vite build",
    "build:analyze": "pnpm run build && pnpm run bundle:report",
    "bundle:check": "node scripts/report-client-bundle.mjs --max-raw-kb=500 --max-total-gzip-kb=1300 --max-total-brotli-kb=1100 --limit=15",
    "bundle:report": "node scripts/report-client-bundle.mjs",
    "build:embedded": "node proxy/build.cjs && node iframe-worker/build.cjs",
    "build:embedded:check": "node proxy/build.cjs --check && node iframe-worker/build.cjs --check",
    "build:system-prompts": "tsc --ignoreConfig buildSystemPrompts.ts --outDir dist --module esnext --target es2022 --moduleResolution bundler --types node --allowImportingTsExtensions false",
    "cf-typegen": "wrangler types",
    "d1:migrations:apply:production": "wrangler d1 migrations apply ghostbuild --remote",
    "generate-routes": "tsr generate",
    "rebuild-template": "node make-bootstrap-snapshot.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:code": "eslint --cache --cache-location ./node_modules/.cache/eslint app ghostbuild-agent scripts iframe-worker/build.cjs proxy/build.cjs make-bootstrap-snapshot.js parse-compressed-messages.mjs",
    "lint": "pnpm run lint:code && prettier -c .",
    "lint:fix-code": "pnpm run lint:code -- --fix",
    "lint:fix": "pnpm run lint:fix-code && prettier --write .",
    "typecheck": "pnpm run generate-routes && pnpm run cf-typegen && tsc",
    "clean": "node scripts/clean.js",
    "provision:production": "node scripts/provision-cloudflare-production.mjs",
    "verify:stack": "node scripts/verify-stack-alignment.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "validate:root": "pnpm run verify:stack && pnpm run verify:production-config && pnpm run build:embedded:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run knip && pnpm run build && pnpm run bundle:check",
    "validate:agent": "pnpm --dir ghostbuild-agent run typecheck && pnpm --dir ghostbuild-agent run test",
    "validate:template": "node scripts/verify-template.mjs",
    "validate": "pnpm run validate:root && pnpm run validate:agent && pnpm run validate:template",
    "knip": "knip --treat-config-hints-as-errors"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.13",
    "@ai-sdk/react": "^3.0.221",
    "@cloudflare/ai-chat": "^0.9.3",
    "@cloudflare/sandbox": "0.12.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-wast": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@heroicons/react": "^2.2.0",
    "@nanostores/react": "^0.7.3",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.19",
    "@tanstack/db": "^0.6.16",
    "@tanstack/query-db-collection": "^1.1.0",
    "@tanstack/react-db": "^0.1.94",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.30",
    "@types/ua-parser-js": "^0.7.39",
    "@uidotdev/usehooks": "^2.4.1",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@webcontainer/api": "1.5.1-internal.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "agents": "^0.17.4",
    "ai": "^6.0.219",
    "date-fns": "^3.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "ghostbuild-agent": "workspace:*",
    "js-cookie": "^3.0.8",
    "jszip": "^3.10.1",
    "lz4-wasm": "^0.9.2",
    "nanostores": "^0.10.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^2.1.9",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "ua-parser-js": "^1.0.41",
    "unist-util-visit": "^5.1.0",
    "workers-ai-provider": "^3.3.1",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@blitz/eslint-plugin": "0.1.5",
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/workers-types": "5.20260718.1",
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/router-cli": "^1.167.21",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@webcontainer/snapshot": "^0.1.0",
    "autoprefixer": "^10.5.4",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "events": "^3.3.0",
    "html-to-image": "^1.11.13",
    "http-proxy": "^1.18.1",
    "jsdom": "^26.1.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^5.88.1",
    "lz4-wasm-nodejs": "^0.9.2",
    "postcss": "^8.5.19",
    "postcss-mixins": "^11.0.3",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.9.5",
    "tailwind-scrollbar": "3.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.1.5",
    "vite-plugin-optimize-css-modules": "^1.4.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "packageManager": "pnpm@11.14.0"
}
