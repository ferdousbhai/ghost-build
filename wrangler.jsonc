{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostbuild",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "app/server.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ghostbuild.dev",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.6,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "ratelimits": [
    {
      "name": "CLIENT_TELEMETRY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "CLOUDFLARE_OAUTH_START_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      // Fast per-location shedding only. Exact per-user rate and byte quotas
      // are admitted atomically by D1 before any backup reaches R2.
      "name": "CHAT_BACKUP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 240,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": [
      "CLOUDFLARE_CREDENTIAL_ENCRYPTION_KEY",
      "CLOUDFLARE_OAUTH_CLIENT_SECRET",
      "DEPLOYMENT_PROXY_JWT_SECRET",
    ],
  },
  "upload_source_maps": true,
  // Configure production secrets in Cloudflare, not local env files.
  // Deployment credentials are supplied by the CI environment, not as Worker runtime secrets.
  // Deploy tooling injects the environment-specific OAuth client id and commit SHA.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghostbuild",
      "database_id": "ecad935d-17df-453a-99eb-f3d025c917a4",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "APP_STORAGE",
      "bucket_name": "ghostbuild-app-storage",
    },
  ],
  "containers": [
    {
      "class_name": "DeploymentSandbox",
      // Workers Builds does not provide Docker. This immutable production
      // image is tied to the reviewed source hash in workers-builds.production.json.
      "image": "registry.cloudflare.com/0af9e0921b880657d84a6c07307f8aef/ghostbuild-deploymentsandbox@sha256:cc0a20cdff32ba56cabeb43a38ddc5e6001bd765cb019496458d47b4140bde13",
      // Generated projects install and compile close to 1 GB of dependencies.
      // The lite tier only has 256 MiB RAM and 1/16 vCPU, which is not a
      // production-capable build environment for the supported stack.
      "instance_type": "basic",
      "max_instances": 2,
    },
  ],
  "workflows": [
    {
      "name": "ghostbuild-deployments",
      "binding": "DeploymentWorkflow",
      "class_name": "DeploymentWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BuilderAgent",
        "class_name": "BuilderAgent",
      },
      {
        "name": "DeploymentSandbox",
        "class_name": "DeploymentSandbox",
      },
    ],
  },
  "exports": {
    "BuilderAgent": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "DeploymentSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "vars": {
    "CLOUDFLARE_OAUTH_SCOPES": "account-settings.read user-details.read workers-scripts.write d1.write workers-r2.write ai.read",
    // Exact tenant-wide request limits, retained byte/object quotas, and edge
    // shedding are enforced after the bounded legacy R2 reconciliation reaches
    // its fail-closed readiness marker.
    "CHAT_BACKUP_STORAGE_QUOTA_MODE": "enforce",
    "CHAT_BACKUP_STORAGE_LIMIT_BYTES": "1073741824",
    "CHAT_BACKUP_STORAGE_LIMIT_OBJECTS": "4096",
    "CHAT_BACKUP_REQUESTS_PER_MINUTE": "120",
    "CHAT_BACKUP_REQUESTS_PER_DAY": "10000",
    "SANDBOX_TRANSPORT": "rpc",
  },
}
