{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostbuild",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "app/server.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ghostbuild.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.6,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "upload_source_maps": true,
  // Configure all production string bindings in Cloudflare, not local env files.
  // Deployment credentials are supplied by the CI environment, not as Worker runtime secrets.
  // Dashboard-managed bindings include the Cloudflare OAuth client,
  // CLOUDFLARE_CREDENTIAL_ENCRYPTION_KEY, and optional commit SHA metadata.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghostbuild",
      "database_id": "ecad935d-17df-453a-99eb-f3d025c917a4",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "APP_STORAGE",
      "bucket_name": "ghostbuild-app-storage",
    },
  ],
  "containers": [
    {
      "class_name": "DeploymentSandbox",
      "image": "./Dockerfile.sandbox",
      // Generated projects install and compile close to 1 GB of dependencies.
      // The lite tier only has 256 MiB RAM and 1/16 vCPU, which is not a
      // production-capable build environment for the supported stack.
      "instance_type": "basic",
      "max_instances": 2,
    },
  ],
  "workflows": [
    {
      "name": "ghostbuild-deployments",
      "binding": "DeploymentWorkflow",
      "class_name": "DeploymentWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BuilderAgent",
        "class_name": "BuilderAgent",
      },
      {
        "name": "DeploymentSandbox",
        "class_name": "DeploymentSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BuilderAgent"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DeploymentSandbox"],
    },
  ],
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
  },
}
