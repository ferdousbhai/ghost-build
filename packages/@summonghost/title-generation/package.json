{
  "name": "@summonghost/title-generation",
  "version": "0.1.2",
  "private": false,
  "description": "Provider-neutral provisional and model-generated title helpers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdousbhai/ghosts.git",
    "directory": "packages/title-generation"
  },
  "homepage": "https://github.com/ferdousbhai/ghosts#readme",
  "bugs": {
    "url": "https://github.com/ferdousbhai/ghosts/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "types:check": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist",
    "pack:check": "pnpm pack --pack-destination ../../dist"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
